{
  "schema_version": "1.0",
  "seed": 0,
  "deterministic": true,
  "families": ["JSP", "FSP", "FJSP", "HFSP"],
  "split": {
    "unit": "instance",
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15,
    "leave_one_family_out": true
  },
  "counterfactuals": {
    "incumbent_rules": ["earliest_finish", "spt", "lpt", "balanced"],
    "closure_levels": [1, 2, 3],
    "controls": [
      "same_operator_random_point",
      "same_point_random_operator",
      "same_closure_size_random_region"
    ]
  },
  "cip_model": {
    "encoder": "relational_gnn",
    "hidden_dim": 96,
    "layers": 3,
    "sparse_closure_weight": 0.02
  },
  "agent": {
    "behavior_cloning_first": true,
    "horizon": 6,
    "algorithm": "masked_ppo",
    "gamma": 0.95
  },
  "generator": {
    "partial_destroy_fractions": [0.1, 0.2, 0.35],
    "candidate_count": 4,
    "solver_fallback": "cp-sat"
  },
  "oracle": {
    "levels": ["code", "static", "light", "full"],
    "full_budget_per_instance": 32
  },
  "statistics": {
    "bootstrap_samples": 2000,
    "confidence": 0.95,
    "alpha": 0.05,
    "multiple_comparison": "holm"
  }
}
