  "fallback_options": [
    {
      "id": "none_of_above",
      "label": "以上均不适用",
      "action": "keep current pool empty and ask the next router stage or adjacent view; never reject candidates"
    },
    {
      "id": "need_adjacent_view",
      "label": "需要相邻视图",
      "action": "expand one hop through view adjacency and rerun union retrieval"
    },
    {
      "id": "evidence_insufficient",
      "label": "证据不足",
      "action": "retain candidate as proposed and route to evidence/IR gap queue"
    },
    {
      "id": "unresolved_new_candidate",
      "label": "可能存在未登记候选",
      "action": "create a Round 4 research question only; do not create a canonical candidate in Round 3"
    }
