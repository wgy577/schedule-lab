{
  "schema_version": "1.1",
  "objective": "makespan",
  "measurement_policy": "Every mechanism is a scalar with an explicit unit and calculation scope. Vague quality/loss/pressure labels are forbidden.",
  "mechanisms": [
    {
      "id": "critical_resource_internal_idle_time",
      "name": "关键资源内部空闲时间",
      "aliases": ["critical machine idle time", "关键机器内部空闲"],
      "description": "关键或最高利用率单容量资源上，相邻已排工序之间内部空闲时间之和。",
      "calculator": "critical_resource_internal_idle_time",
      "required_data": ["assignments", "selected modes", "resource capacities"],
      "unit": "time",
      "objective_direction": "decrease_usually_improves",
      "limitations": ["必须通过最终 makespan 验证", "并非所有内部空闲都可消除"]
    },
    {
      "id": "realized_schedule_critical_path_length",
      "name": "实现调度关键路径长度",
      "aliases": ["realized critical path", "析取图最长路径"],
      "description": "由工艺前置边与实现机器顺序边构造的调度 DAG 最长路径。若其等于 makespan，只作为主目标分解，不列作独立次级目标。",
      "calculator": "realized_schedule_critical_path_length",
      "required_data": ["precedence", "assignments", "selected resources"],
      "unit": "time",
      "objective_direction": "objective_decomposition_only",
      "limitations": ["关系图成环时不可用", "通常与 makespan 数值等价"]
    },
    {
      "id": "operation_ready_to_start_waiting_time",
      "name": "工序就绪后等待时间",
      "aliases": ["ready-to-start waiting time", "工序就绪等待"],
      "description": "工序满足释放与作业内前置关系后，到实际开始之间等待时间之和。",
      "calculator": "operation_ready_to_start_waiting_time",
      "required_data": ["releases", "precedence", "assignments"],
      "unit": "time",
      "objective_direction": "decrease_may_improve",
      "limitations": ["等待减少可能把资源冲突转移到其他机器"]
    },
    {
      "id": "resource_utilization_coefficient_of_variation",
      "name": "资源利用率变异系数",
      "aliases": ["utilization coefficient of variation", "机器利用率变异系数"],
      "description": "同类已使用资源利用率的样本标准差除以均值。",
      "calculator": "resource_utilization_coefficient_of_variation",
      "required_data": ["selected resources", "assignment durations", "resource capacity"],
      "unit": "coefficient_of_variation",
      "objective_direction": "decrease_may_improve",
      "limitations": ["异构资源必须按 family 分层计算", "不能替代最大机器工作负荷"]
    },
    {
      "id": "total_sequence_dependent_setup_time",
      "name": "序列相关准备时间总和",
      "aliases": ["total setup time", "total changeover time", "准备时间总和"],
      "description": "候选排程显式记录的 setup/changeover 时间总和。",
      "calculator": "metadata_total_setup_time",
      "required_data": ["assignment metadata setup_time/setup_duration"],
      "unit": "time",
      "objective_direction": "decrease_may_improve",
      "limitations": ["无显式 setup 数据时不可计算"]
    },
    {
      "id": "transport_induced_waiting_time",
      "name": "运输引起的等待时间",
      "aliases": ["transport-induced waiting", "运输等待时间"],
      "description": "候选排程中由运输、车辆等待和运输同步造成的等待时间总和。",
      "calculator": "metadata_transport_induced_waiting_time",
      "required_data": ["assignment metadata transport_delay/synchronization_delay"],
      "unit": "time",
      "objective_direction": "decrease_may_improve",
      "limitations": ["无轨迹或运输 Oracle 数据时不可计算"]
    },
    {
      "id": "total_blocking_time",
      "name": "总阻塞时间",
      "aliases": ["total blocking time", "阻塞时间总和"],
      "description": "有限缓冲或 blocking 变体中工件占用上游资源等待下游可用的时间总和。",
      "calculator": "metadata_total_blocking_time",
      "required_data": ["assignment metadata blocking_delay"],
      "unit": "time",
      "objective_direction": "decrease_may_improve",
      "limitations": ["必须由 blocking 变体适配器或 Oracle 提供", "no-wait 违反属于不可行性而非优化指标"]
    },
    {
      "id": "resource_capacity_idle_rate",
      "name": "资源容量空闲率",
      "aliases": ["capacity idle rate", "资源容量时间空闲比例"],
      "description": "排程跨度内总资源容量时间减去忙碌容量时间，再除以总资源容量时间。",
      "calculator": "resource_capacity_idle_rate",
      "required_data": ["resource capacities", "assignment durations", "makespan"],
      "unit": "fraction",
      "objective_direction": "decrease_may_improve",
      "limitations": ["包含不可避免空闲", "只能用于同实例同资源集合的候选对比"]
    }
  ]
}
