  "families": [
    {
      "family": "JSP",
      "aliases": ["JSP", "JSSP", "job shop", "job-shop", "作业车间", "作业车间调度"],
      "definition": "每个作业包含按给定工艺顺序执行的工序；每道工序通常绑定一台指定机器；同一机器上的工序需要排序。",
      "defining_features": [
        "不同作业可以具有不同机器访问顺序",
        "同一作业内存在固定工序前置关系",
        "经典问题中每道工序只有一台指定机器",
        "经典主要决策是同机工序排序，开始时间通常由序列和最早可行插入派生"
      ],
      "core_constraints": [
        {
          "kind": "precedence",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "high",
          "note": "决定作业内部可行顺序和关键路径传播"
        },
        {
          "kind": "no_overlap",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "critical",
          "note": "同机排序是经典 JSP 的主要组合决策"
        },
        {
          "kind": "resource_eligibility",
          "role": "fixed_instance_structure",
          "typical_optimization_leverage": "low",
          "note": "经典 JSP 中机器通常固定，不是资源分配决策"
        },
        {
          "kind": "other",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "low",
          "note": "不可抢占通常由单一连续加工区间隐式实现"
        }
      ],
      "primary_decisions": ["sequence", "select"],
      "default_assumptions": [
        "静态、确定性、离线",
        "所有作业通常在时间 0 可用",
        "机器容量为 1",
        "不可抢占",
        "加工时间已知"
      ],
      "common_variants": [
        {
          "id": "jsp_release_dates_dynamic",
          "aliases": ["release time", "release date", "arrival", "dynamic JSP", "动态作业车间", "释放时间", "到达时间"],
          "added_features": ["非零释放时间", "在线到达或滚动重调度"],
          "decision_changes": ["可能增加 release/accept-reject/重调度决策"],
          "impact_note": "若所有候选共享相同且全为零的释放时间，优化杠杆低；动态到达时可能成为关键状态变量"
        },
        {
          "id": "jsp_setup",
          "aliases": ["setup time", "sequence-dependent setup", "换型", "准备时间"],
          "added_features": ["顺序相关或机器相关准备时间"],
          "decision_changes": ["机器序列对实际加工时长和关键路径的影响增强"],
          "impact_note": "通常是高优化杠杆"
        },
        {
          "id": "jsp_transport",
          "aliases": ["transport", "AGV", "vehicle", "路径", "运输", "搬运"],
          "added_features": ["工序间运输、车辆容量、路径或碰撞约束"],
          "decision_changes": ["运输资源分配、路由、同步"],
          "impact_note": "只在项目真实建模运输时进入优化核心"
        },
        {
          "id": "jsp_no_wait_blocking",
          "aliases": ["no-wait", "no wait", "blocking", "无等待", "阻塞"],
          "added_features": ["工序间零等待或有限缓冲阻塞"],
          "decision_changes": ["局部排序会产生更大范围的时间传播"],
          "impact_note": "通常显著收缩可行域"
        },
        {
          "id": "jsp_dual_resource",
          "aliases": ["worker", "operator", "dual resource", "人员", "工人", "双资源"],
          "added_features": ["机器与人员等多资源同步占用"],
          "decision_changes": ["多资源分配与同步"],
          "impact_note": "资源选择和容量可能成为关键杠杆"
        },
        {
          "id": "jsp_stochastic_robust",
          "aliases": ["stochastic", "uncertain", "robust", "fuzzy", "随机", "不确定", "鲁棒", "模糊"],
          "added_features": ["随机加工时间、故障或不确定到达"],
          "decision_changes": ["策略、缓冲和风险权衡"],
          "impact_note": "不能使用确定性 JSP 先验直接过滤"
        }
      ],
      "source_ids": ["google_or_tools_jsp", "jsp_types_review_2022"]
    },
    {
      "family": "FSP",
      "aliases": ["FSP", "flow shop", "flow-shop", "flowshop", "流水车间", "流水作业"],
      "definition": "所有作业经过相同的机器或阶段顺序；一般 FSP 允许不同机器上的作业顺序不同，PFSP 要求所有机器使用同一作业排列。",
      "defining_features": [
        "所有作业共享相同机器访问顺序",
        "机器容量通常为 1",
        "FSP 与 PFSP 必须区分",
        "主要决策是各机器顺序，PFSP 中缩减为一个全局排列"
      ],
      "core_constraints": [
        {
          "kind": "precedence",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "high",
          "note": "所有作业遵循相同工艺路线"
        },
        {
          "kind": "no_overlap",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "critical",
          "note": "机器上的排列决定拥塞和关键路径"
        }
      ],
      "primary_decisions": ["sequence"],
      "default_assumptions": ["静态、确定性、离线", "机器容量为 1", "不可抢占", "加工时间已知"],
      "common_variants": [
        {
          "id": "pfsp",
          "aliases": ["PFSP", "permutation flow shop", "permutation flowshop", "置换流水车间"],
          "added_features": ["所有机器共享同一作业排列"],
          "decision_changes": ["只优化一个全局排列"],
          "impact_note": "这是搜索空间结构，不应当误识别为普通 FSP 的普遍约束"
        },
        {
          "id": "npfsp",
          "aliases": ["NPFSP", "non-permutation", "non permutation", "非置换流水车间"],
          "added_features": ["不同机器允许不同作业顺序"],
          "decision_changes": ["每台机器独立排序"],
          "impact_note": "自由度更大，邻域和编码不同"
        },
        {
          "id": "fsp_no_wait_blocking",
          "aliases": ["no-wait", "no wait", "blocking", "limited buffer", "无等待", "阻塞", "有限缓冲"],
          "added_features": ["零等待、阻塞或有限中间缓冲"],
          "decision_changes": ["顺序变化引起跨机器耦合"],
          "impact_note": "通常是高可行域影响和高优化杠杆"
        },
        {
          "id": "fsp_setup",
          "aliases": ["setup time", "sequence-dependent setup", "换型", "准备时间"],
          "added_features": ["顺序相关准备时间"],
          "decision_changes": ["排序同时改变额外时长"],
          "impact_note": "通常高杠杆"
        },
        {
          "id": "distributed_fsp",
          "aliases": ["distributed flow shop", "DPFSP", "分布式流水车间", "工厂分配"],
          "added_features": ["多工厂/多产线分配"],
          "decision_changes": ["工厂选择加作业排序"],
          "impact_note": "assignment 与 sequence 都是核心决策"
        },
        {
          "id": "reentrant_fsp",
          "aliases": ["reentrant", "re-entrant", "重入", "回流"],
          "added_features": ["作业重复访问阶段或机器"],
          "decision_changes": ["访问层级和机器序列耦合"],
          "impact_note": "不能套用单遍标准 FSP"
        }
      ],
      "source_ids": ["pfsp_review_2005", "npfsp_review_2018"]
    },
    {
      "family": "HFSP",
      "aliases": ["HFSP", "HFS", "hybrid flow shop", "flexible flow shop", "混合流水车间", "柔性流水车间"],
      "definition": "作业依次经过相同的生产阶段，至少一个阶段具有两台或以上并行机器；需要同时决定阶段内机器分配和同机作业排序。",
      "defining_features": [
        "所有作业经过相同阶段顺序",
        "至少一个阶段具有并行机器",
        "机器可以是相同、均匀或不相关",
        "主要决策是阶段机器分配与同机排序"
      ],
      "core_constraints": [
        {
          "kind": "precedence",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "high",
          "note": "阶段顺序固定"
        },
        {
          "kind": "resource_capacity",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "critical",
          "note": "阶段并行容量决定瓶颈"
        },
        {
          "kind": "resource_eligibility",
          "role": "decision_lever",
          "typical_optimization_leverage": "critical",
          "note": "机器分配通常是核心组合决策"
        },
        {
          "kind": "no_overlap",
          "role": "feasibility_guard",
          "typical_optimization_leverage": "critical",
          "note": "分配后仍需同机排序"
        }
      ],
      "primary_decisions": ["assign_resource", "sequence"],
      "default_assumptions": [
        "静态、确定性、离线",
        "作业在时间 0 可用",
        "同阶段机器经典情况下相同",
        "无限中间缓冲",
        "不可抢占"
      ],
      "common_variants": [
        {
          "id": "hfsp_unrelated_eligibility",
          "aliases": ["unrelated parallel", "uniform parallel", "eligibility", "异构并行机", "机器资格"],
          "added_features": ["同阶段机器速度不同或工序仅可选部分机器"],
          "decision_changes": ["机器分配影响加工时长与可行性"],
          "impact_note": "通常是关键杠杆"
        },
        {
          "id": "hfsp_blocking_buffer",
          "aliases": ["blocking", "limited buffer", "buffer", "阻塞", "有限缓冲", "缓冲区"],
          "added_features": ["有限或零阶段间缓冲"],
          "decision_changes": ["上游释放与下游容量强耦合"],
          "impact_note": "通常显著改变关键路径与可行域"
        },
        {
          "id": "hfsp_setup",
          "aliases": ["setup time", "sequence-dependent setup", "machine-dependent setup", "换型", "准备时间"],
          "added_features": ["顺序和机器相关准备时间"],
          "decision_changes": ["分配与排序共同改变额外时长"],
          "impact_note": "通常高杠杆"
        },
        {
          "id": "hfsp_no_wait",
          "aliases": ["no-wait", "no wait", "无等待"],
          "added_features": ["相邻阶段之间不得等待"],
          "decision_changes": ["时间联动范围扩大"],
          "impact_note": "高可行域影响"
        },
        {
          "id": "hfsp_batch",
          "aliases": ["batch", "batching", "批处理", "成批"],
          "added_features": ["批形成与批容量"],
          "decision_changes": ["批选择、分配和排序"],
          "impact_note": "增加新的核心决策层"
        },
        {
          "id": "hfsp_transport",
          "aliases": ["transport", "AGV", "vehicle", "运输", "搬运", "路径"],
          "added_features": ["阶段间运输资源和时间"],
          "decision_changes": ["车辆分配、路径和同步"],
          "impact_note": "只在项目真实建模时进入核心"
        }
      ],
      "source_ids": ["hfsp_review_2010"]
    },
    {
      "family": "FJSP",
